<launch>
    <!--
        Excitation Trajectory Replay with Inertial Parameter Identification

        Workflow:
        teleop mode (default):
          1. Move to home → zero_ftsensor (bare flange+gripper) → teleop grasp
          2. Close gripper
          3. Move to start pose → replay → identify → re-sync leader

        skip_teleop mode:
          3. Move to start pose → zero_ftsensor (bare flange) → replay → identify → re-sync leader

        Prerequisites (must be running separately):
        - UR driver: roslaunch osx_ur5e connect_real_robot.launch

        Usage:
            roslaunch iparam_identification replay_excitation_trajectory.launch
            roslaunch iparam_identification replay_excitation_trajectory.launch skip_teleop:=true
            roslaunch iparam_identification replay_excitation_trajectory.launch leader_port:=/dev/ttyUSB1
    -->

    <!-- ========== Arguments ========== -->
    <arg name="trajectory" default="$(find iparam_identification)/data/trajectories/excitation_trajectory.json"/>
    <arg name="wrench_topic" default="/wrench"/>
    <arg name="cutoff_freq" default="10.0"/>
    <arg name="trim_start" default="0.0"/>
    <arg name="trim_end" default="inf"/>
    <arg name="skip_teleop" default="false" doc="Skip teleop/gripper phases; zero F/T at start pose in standalone mode (for gripper-only identification)"/>
    <arg name="tls_scaling" default="noise_variance" doc="TLS scaling mode: identity, data_variance, noise_variance"/>
    <arg name="gripper_calibration" default="$(find iparam_identification)/data/calibration/gripper.json" doc="Gripper calibration file for difference method. Set empty to disable."/>
    <arg name="standalone" default="true" doc="true=interactive CLI, false=ActionServer mode"/>
    <arg name="n_laps" default="3" doc="Number of back-to-back replays of the periodic excitation trajectory in phase 4"/>
    <arg name="run_identification" default="false" doc="true=run phase 5+ (identify/publish); false=replay+record only"/>
    <arg name="zero_ftsensor" default="true" doc="true=zero the F/T sensor before replay; false=record raw, un-tared wrench"/>
    <arg name="leader_port" default="/dev/ttyUSB0" doc="Dynamixel leader arm serial port"/>
    <arg name="teleop_config" default="$(find osx_bilateral)/configs/teleop.yaml"/>

    <!-- ========== Teleop Infrastructure (skipped when skip_teleop:=true) ========== -->

    <!-- Dynamixel motor controller (leader arm) -->
    <node pkg="dynamixel_sdk_examples"
          type="sync_read_write_current_node"
          name="sync_current_control_node"
          output="screen"
          unless="$(arg skip_teleop)">
        <param name="device_name" value="$(arg leader_port)"/>
    </node>

    <!-- Haptic feedback publisher (gravity compensation) -->
    <node pkg="osx_bilateral"
          type="haptic_feedback_publisher.py"
          name="haptic_feedback_publisher"
          output="screen"
          unless="$(arg skip_teleop)">
        <param name="config_path" value="$(arg teleop_config)"/>
    </node>

    <!-- ========== Main Node ========== -->

    <!-- Excitation Trajectory Replay Node
         Kinematics are computed directly inside the node (no external kinematics node needed).
         This guarantees la/regressor/wrench consistency within each recorded frame. -->
    <node pkg="iparam_identification" type="replay_excitation_trajectory.py"
          name="batch_identifier" output="screen" required="true">
        <param name="trajectory_path" value="$(arg trajectory)"/>
        <param name="wrench_topic" value="$(arg wrench_topic)"/>
        <param name="cutoff_freq" value="$(arg cutoff_freq)"/>
        <param name="trim_start" value="$(arg trim_start)"/>
        <param name="trim_end" value="$(arg trim_end)"/>
        <param name="skip_teleop" value="$(arg skip_teleop)"/>
        <param name="tls_scaling" value="$(arg tls_scaling)"/>
        <param name="gripper_calibration" value="$(arg gripper_calibration)"/>
        <param name="standalone" value="$(arg standalone)"/>
        <param name="n_laps" value="$(arg n_laps)"/>
        <param name="run_identification" value="$(arg run_identification)"/>
        <param name="zero_ftsensor" value="$(arg zero_ftsensor)"/>
    </node>
</launch>
