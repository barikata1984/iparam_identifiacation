<launch>
    <!-- Launch file for wrist end kinematics publisher -->

    <arg name="base_link" default="base_link"/>
    <arg name="ee_link" default="tool0"/>
    <arg name="cutoff_freq" default="10.0"/>

    <node name="wrist_end_kinematics" pkg="iparam_identification" type="wrist_end_kinematics_node.py" output="screen">
        <param name="base_link" value="$(arg base_link)"/>
        <param name="ee_link" value="$(arg ee_link)"/>
        <param name="cutoff_freq" value="$(arg cutoff_freq)"/>
    </node>
</launch>
