<launch>
    <!-- Arguments -->
    <arg name="wrench_topic" default="/wrench"/>
    <arg name="cutoff_freq" default="10.0"/>

    <!-- Pinocchio-based Kinematics Node -->
    <include file="$(find iparam_identification)/launch/tool0_kinematics.launch">
        <arg name="cutoff_freq" value="$(arg cutoff_freq)"/>
    </include>

    <!-- Batch Identifier Node (Interactive CLI) -->
    <node pkg="iparam_identification" type="batch_identifier.py" name="batch_identifier" output="screen">
        <param name="wrench_topic" value="$(arg wrench_topic)"/>
        <param name="kinematics_ns" value="/tool0_kinematics"/>
    </node>
</launch>
