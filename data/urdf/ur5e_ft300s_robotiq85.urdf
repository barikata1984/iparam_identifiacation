  </link>
  <!-- Connect force sensor with mounting/coupling plate -->
  <joint name="ft300_mounting_plate" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0.0415"/>
    <parent link="ft300_mounting_plate"/>
    <child link="ft300_sensor"/>
  </joint>
  <!-- FORCE REFERENCE FRAME _______________________________________________________________________________
            The physical sensor measurement frame (per Robotiq manual) differs
            from tool0 by Rz(+90°):
              ft_x_physical =  tool0_y
              ft_y_physical = -tool0_x
              ft_z_physical =  tool0_z
            This URDF intentionally aligns robotiq_ft_frame_id with tool0 so
            that the identification pipeline can consume the wrench directly.
            The Rz(+90°) rotation from the sensor's native frame to tool0 must
            be applied in the republisher / subscriber instead. -->
  <joint name="measurment_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <parent link="ft300_sensor"/>
    <child link="robotiq_ft_frame_id"/>
  </joint>
  <link name="robotiq_ft_frame_id"/>
  <joint name="robotiq_85_base_joint" type="fixed">
    <parent link="ft300_mounting_plate"/>
    <child link="robotiq_85_base_link"/>
    <origin rpy="0 -1.5707963267948966 1.5707963267948966" xyz="0 0 0.0415"/>
  </joint>
  <link name="robotiq_85_base_link"/>
  <joint name="robotiq_arg2f_base_joint" type="fixed">
    <parent link="robotiq_85_base_link"/>
    <child link="robotiq_arg2f_base_link"/>
    <origin rpy="3.141592653589793 -1.5707963267948966 0" xyz="0 0 0"/>
  </joint>
  <link name="robotiq_arg2f_base_link">
    <!-- mass = 0.788 kg lumps in the motor / gearbox / electronics that
           the CAD-derived value 0.22652 kg did not account for, so the
           assembled 2F-85 mass matches the Robotiq catalog (0.925 kg)
           together with the 0.137 kg of moving fingers defined below.
           CoM/inertia are left at the CAD values (housing only). -->
    <inertial>
      <origin rpy="0 0 0" xyz="8.625E-08 -4.6583E-06 0.03145"/>
      <mass value="0.788"/>
      <inertia ixx="0.00020005" ixy="-4.2442E-10" ixz="-2.9069E-10" iyy="0.00017832" iyz="-3.4402E-08" izz="0.00013478"/>
    </inertial>
    <visual>
