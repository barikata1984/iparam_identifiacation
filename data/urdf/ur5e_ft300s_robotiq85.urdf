  <!-- Link representing the FT300 force-torque sensor.
             NOTE: mass and CoM below are FT300-S values (not FT300) per
             Robotiq FT300-S Instruction Manual section 5.2.1:
                 mass = 442 g, CoM = (-6, 0, 13.5) mm in the sensor
                 measurement frame (robotiq_ft_frame_id).
             Expressed here in ft300_sensor frame, which differs from
             robotiq_ft_frame_id by rpy=(0, 0, pi/2), so the CoM
             becomes (0, 6, 13.5) mm.
             The inertia tensor is left at the FT300 estimate (no
             FT300-S figure published). -->
  <link name="ft300_sensor">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0.006 0.0135"/>
      <mass value="0.442"/>
      <inertia ixx="0.000262" ixy="0" ixz="1e-06" iyx="0" iyy="0.000265" iyz="1e-06" izx="-1e-06" izy="1e-06" izz="0.000219"/>
    </inertial>
